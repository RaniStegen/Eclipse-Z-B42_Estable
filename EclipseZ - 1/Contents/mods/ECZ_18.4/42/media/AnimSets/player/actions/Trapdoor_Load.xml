<?xml version="1.0" encoding="utf-8"?>
<animNode>
  <m_Name>Trapdoor_Load</m_Name>
  <m_AnimName>Bob_TrapdoorReload</m_AnimName>
  <m_deferredBoneAxis>Y</m_deferredBoneAxis>
  <m_Looped>false</m_Looped>
  <m_SyncTrackingEnabled>false</m_SyncTrackingEnabled>
  <m_EarlyTransitionOut>true</m_EarlyTransitionOut>
  <m_SpeedScale>ReloadSpeed</m_SpeedScale>
  <m_ConditionPriority>10</m_ConditionPriority>
  <m_BlendTime>0.20</m_BlendTime>
  <m_Conditions>
    <m_Name>PerformingAction</m_Name>
    <m_Type>STRING</m_Type>
    <m_StringValue>Reload</m_StringValue>
  </m_Conditions>
  <m_Conditions>
    <m_Name>GunworksReloadAnim</m_Name>
    <m_Type>STRING</m_Type>
    <m_StringValue>Trapdoor</m_StringValue>
  </m_Conditions>
  <m_Conditions>
    <m_Name>isLoading</m_Name>
    <m_Type>BOOL</m_Type>
    <m_BoolValue>true</m_BoolValue>
  </m_Conditions>
  <m_Events>
    <m_EventName>loadFinished</m_EventName>
    <m_Time>End</m_Time>
    <m_ParameterValue></m_ParameterValue>
  </m_Events>
  <m_Events>
    <m_EventName>playReloadSound</m_EventName>
    <m_Time>Start</m_Time>
    <m_ParameterValue>insertAmmoStart</m_ParameterValue>
  </m_Events>
  <m_Events>
    <m_EventName>playReloadSound</m_EventName>
    <m_TimePc>0.5000</m_TimePc>
    <m_ParameterValue>load</m_ParameterValue>
  </m_Events>
  <!-- Gun-part swaps (gwSetPart, value "PartType=fullType"): open the breech, close it after the
       cartridge is in, then cock the hammer. Retune in the Anim Forge reload editor. -->
  <m_Events>
    <m_EventName>gwSetHandProp</m_EventName>
    <m_TimePc>0.4731</m_TimePc>
    <m_ParameterValue>Gunsmithing.HandmadeCartridge</m_ParameterValue>
  </m_Events>
  <m_Events>
    <m_EventName>gwSetPart</m_EventName>
    <m_TimePc>0.2870</m_TimePc>
    <m_ParameterValue>GunsmithingTrapDoor=Gunsmithing.1875Gun_TrapDoorOpen</m_ParameterValue>
  </m_Events>
  <m_Events>
    <m_EventName>gwSetHandProp</m_EventName>
    <m_TimePc>0.6610</m_TimePc>
    <m_ParameterValue></m_ParameterValue>
  </m_Events>
  <m_Events>
    <m_EventName>gwSetPart</m_EventName>
    <m_TimePc>0.7940</m_TimePc>
    <m_ParameterValue>GunsmithingTrapDoor=Gunsmithing.1875Gun_TrapDoorClosed</m_ParameterValue>
  </m_Events>
  <m_Events>
    <m_EventName>gwSetPart</m_EventName>
    <m_TimePc>0.1700</m_TimePc>
    <m_ParameterValue>GunsmithingHammer=Gunsmithing.1875Gun_HammerCooked</m_ParameterValue>
  </m_Events>
</animNode>
