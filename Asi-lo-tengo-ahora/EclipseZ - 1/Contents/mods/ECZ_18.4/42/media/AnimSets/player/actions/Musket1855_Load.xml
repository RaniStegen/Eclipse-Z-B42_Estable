<?xml version="1.0" encoding="utf-8"?>
<animNode>
  <m_Name>Musket1855_Load</m_Name>
  <m_AnimName>Bob_MusketReload</m_AnimName>
  <m_deferredBoneAxis>Y</m_deferredBoneAxis>
  <m_Looped>false</m_Looped>
  <m_SyncTrackingEnabled>false</m_SyncTrackingEnabled>
  <m_EarlyTransitionOut>true</m_EarlyTransitionOut>
  <m_SpeedScale>ReloadSpeed</m_SpeedScale>
  <m_ConditionPriority>10</m_ConditionPriority>
  <m_BlendTime>0.20</m_BlendTime>
  <m_Conditions>
    <m_Name>PerformingAction</m_Name>
    <m_Type>STRING</m_Type>
    <m_StringValue>Reload</m_StringValue>
  </m_Conditions>
  <m_Conditions>
    <m_Name>GunworksReloadAnim</m_Name>
    <m_Type>STRING</m_Type>
    <m_StringValue>Musket1855</m_StringValue>
  </m_Conditions>
  <m_Conditions>
    <m_Name>isLoading</m_Name>
    <m_Type>BOOL</m_Type>
    <m_BoolValue>true</m_BoolValue>
  </m_Conditions>
  <m_Events>
    <m_EventName>loadFinished</m_EventName>
    <m_Time>End</m_Time>
    <m_ParameterValue></m_ParameterValue>
  </m_Events>
  <m_Events>
    <m_EventName>playReloadSound</m_EventName>
    <m_Time>Start</m_Time>
    <m_ParameterValue>insertAmmoStart</m_ParameterValue>
  </m_Events>
  <m_Events>
    <m_EventName>playReloadSound</m_EventName>
    <m_TimePc>0.3000</m_TimePc>
    <m_ParameterValue>load</m_ParameterValue>
  </m_Events>
  <!-- Same as Musket1770_Load but the paper cartridge is kept in hand (no swap to a musket ball)
       until it is rammed home. Ramrod + sounds + timing are identical. -->
  <m_Events>
    <m_EventName>gwSetHandProp</m_EventName>
    <m_TimePc>0.0650</m_TimePc>
    <m_ParameterValue>Gunsmithing.PaperCartridge</m_ParameterValue>
  </m_Events>
  <m_Events>
    <m_EventName>gwSetHandProp</m_EventName>
    <m_TimePc>0.2220</m_TimePc>
    <m_ParameterValue></m_ParameterValue>
  </m_Events>
  <m_Events>
    <m_EventName>gwPartToHand</m_EventName>
    <m_TimePc>0.2560</m_TimePc>
    <m_ParameterValue>Gunsmithing.Musket1770_RamRod</m_ParameterValue>
  </m_Events>
  <m_Events>
    <m_EventName>gwPartToGun</m_EventName>
    <m_TimePc>0.7170</m_TimePc>
    <m_ParameterValue>Gunsmithing.Musket1770_RamRod</m_ParameterValue>
  </m_Events>
</animNode>
